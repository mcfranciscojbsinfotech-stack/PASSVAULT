datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("USER") // "USER" | "ADMIN"
  isVerified   Boolean  @default(false)
  isSuspended  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions       AuthenticationSession[]
  mfaConfig      MfaConfig?
  tokens         OneTimeToken[]
  vaultItems     EncryptedVaultItem[]
  auditEvents    AuditEvent[]

  @@map("users")
}

model AuthenticationSession {
  id               String   @id @default(uuid())
  userId           String
  sessionTokenHash String   @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  isRevoked        Boolean  @default(false)
  lastActiveAt     DateTime @default(now())
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("authentication_sessions")
}

model MfaConfig {
  id          String   @id @default(uuid())
  userId      String   @unique
  isEnabled   Boolean  @default(false)
  secret      String
  backupCodes String   @default("[]") // JSON array of hashed recovery codes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_configs")
}

model OneTimeToken {
  id        String   @id @default(uuid())
  userId    String
  type      String   // "EMAIL_VERIFY" | "EMAIL_MFA" | "PASSWORD_RESET"
  tokenHash String   @unique
  expiresAt DateTime
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("one_time_tokens")
}

model EncryptedVaultItem {
  id               String   @id @default(uuid())
  userId           String
  itemId           String   // UUID generated on the client
  encryptedPayload String   // Serialized versioned JSON envelope
  revision         Int      @default(1)
  isDeleted        Boolean  @default(false)
  clientUpdatedAt  DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, isDeleted])
  @@map("encrypted_vault_items")
}

model AuditEvent {
  id          String   @id @default(uuid())
  userId      String?
  actorEmail  String?
  eventType   String
  status      String   // "SUCCESS" | "FAILURE"
  ipAddress   String?
  userAgent   String?
  detailsJson String?  // Purely operational, non-sensitive metadata
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId])
  @@map("audit_events")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  valueJson String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
