# Database connection (SQLite for local out-of-the-box development & testing; PostgreSQL supported in production)
DATABASE_URL="file:./dev.db"

# Server configuration
PORT=4000
HOST="127.0.0.1"
API_BASE_URL="http://localhost:4000"
APP_BASE_URL="http://localhost:3000"

# Session & Security secrets
SESSION_SECRET="passvault-dev-session-super-secret-key-at-least-32-chars-long"
COOKIE_DOMAIN=""
NODE_ENV="development"

# Admin initial provisioning (used only when database is empty)
FIRST_ADMIN_EMAIL="admin@passvault.local"
FIRST_ADMIN_PASSWORD="PassVaultAdmin123!"

# Email provider (simulated/console logger in development)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="noreply@passvault.local"
